# Kopiraj u .env.local (ne ide u git).

# Worker: direktna veza sa bazom (lokalno: npm run db:start, pa `npx supabase status`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
WORKER_CONCURRENCY=2

# AI: Faza 0 koristi Claude Code sa tvojom pretplatom (samo za naše brendove i testiranje).
AI_PROVIDER=claude-code
# Na serveru/GitHub-u: token iz `claude setup-token`. Lokalno nije potreban ako si prijavljen u Claude Code.
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_BIN=claude

# Faza 2+: HTTP deo workera (OAuth povratci, unos tokena), skladište slika, šifrovanje tokena
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=
# tajni ključ (service_role): samo za worker, nikad u pregledač
SUPABASE_SERVICE_ROLE_KEY=
# 32 bajta, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
WORKER_PUBLIC_URL=http://localhost:8787
WEB_URL=http://localhost:4300
WORKER_HTTP_PORT=8787

# Meta aplikacija (developers.facebook.com → Instagram API with Instagram login); redirect: WORKER_PUBLIC_URL/oauth/instagram/povratak
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Faza 7 — AI za spoljne korisnike: naš Anthropic ključ (AI uključen u plan). Bez njega i bez AI_PROVIDER=claude-code AI ne radi.
# Za razvoj sa pretplatom ostavi AI_PROVIDER=claude-code (ima prednost). Korisnik može da doda i sopstveni ključ u aplikaciji.
# ANTHROPIC_API_KEY=
# Plaćanje (Stripe): bez ključa aplikacija kaže „plaćanje još nije uključeno“. Webhook: WORKER_PUBLIC_URL/naplata/webhook
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_AGENCIJA=

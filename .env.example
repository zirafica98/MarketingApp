# Kopiraj u .env.local (ne ide u git).

# Worker: direktna veza sa bazom (lokalno: npm run db:start, pa `npx supabase status`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
WORKER_CONCURRENCY=2

# AI: Faza 0 koristi Claude Code sa tvojom pretplatom (samo za naše brendove i testiranje).
AI_PROVIDER=claude-code
# Na serveru/GitHub-u: token iz `claude setup-token`. Lokalno nije potreban ako si prijavljen u Claude Code.
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_BIN=claude
